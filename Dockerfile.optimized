# Task 5 - multi-stage build: smaller image, non-root user
# Stage 1 (builder): install only the runtime packages into a virtualenv, then strip what isn't needed
FROM python:3.11-slim AS builder
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir pandas matplotlib seaborn azure-storage-blob \
    && find /opt/venv -type d -name tests -prune -exec rm -rf {} + \
    && pip uninstall -y pip

# Stage 2 (runtime): fresh slim image + only the finished virtualenv and app files
FROM python:3.11-slim
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
RUN useradd --create-home appuser
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY --chown=appuser:appuser data_analysis.py lambda_function.py ./
COPY --chown=appuser:appuser data/ ./data/
RUN mkdir -p outputs simulated_nosql && chown appuser:appuser outputs simulated_nosql
USER appuser
CMD ["python", "data_analysis.py"]
